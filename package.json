{
  "name": "edgephotos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.web.json && tsc -p tsconfig.node.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts --include-runtime=false",
    "backup": "node scripts/backup.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hono/zod-openapi": "^1.6.3",
    "@preact/signals": "^2.11.2",
    "aws4fetch": "^1.0.20",
    "exifr": "^7.1.3",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "preact": "^10.29.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@cloudflare/vite-plugin": "^1.54.9",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260914.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.2"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.18"
  }
}
