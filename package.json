{
  "name": "edgephotos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.web.json && tsc -p tsconfig.node.json && tsc -p tsconfig.e2e.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bench": "vitest run --config vitest.bench.config.ts --reporter=verbose --silent=false",
    "check": "pnpm typecheck && pnpm lint && pnpm db:check && pnpm cli:check && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate --name",
    "db:check": "node scripts/db-check.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts --include-runtime=false",
    "backup": "node scripts/backup.ts",
    "diagnose": "node scripts/diagnose.ts",
    "storage": "node scripts/storage.ts",
    "cli:check": "node scripts/cli-check.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hono/zod-openapi": "^1.6.3",
    "@preact/signals": "^2.11.2",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.2",
    "exifr": "^7.1.3",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "preact": "^10.29.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@cloudflare/vite-plugin": "^1.54.9",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260914.1",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.18"
  }
}
